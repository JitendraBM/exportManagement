# .env.production.example
# -----------------------
# Copy to `.env` ON THE SERVER and fill in. `.env` is never committed
# (see .gitignore). This is the production counterpart of `.env.example`
# (which targets local dev).

# REQUIRED. Generate a fresh one - do NOT reuse any value from a dev machine
# or from git history; a known key lets anyone forge a login session. The app
# refuses to start without DEBUG if this is still the built-in default.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Never run the production server with the debugger on.
DEBUG=false

# Session cookies must be HTTPS-only in production (this is the default; shown
# here for clarity). Set to false ONLY for a plain-HTTP local box.
SESSION_COOKIE_SECURE=true

# gunicorn binds loopback; nginx is the public listener.
HOST=127.0.0.1
PORT=8000

# Upload cap (MB). Keep in step with nginx client_max_body_size.
MAX_UPLOAD_MB=550

# Optional login-hardening overrides (defaults shown).
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# LOGIN_IP_MAX_ATTEMPTS=20
# LOGIN_IP_WINDOW_SECONDS=300
# PASSWORD_MIN_LENGTH=10

# DATABASE_PATH=/opt/crm/crm_app/instance/crm.db

# WERKZEUG_DEBUG is intentionally omitted. Enabling it on an internet-facing
# host exposes an interactive Python console. It now also requires
# WERKZEUG_DEBUG_CONFIRM=1 as a second, deliberate opt-in.
