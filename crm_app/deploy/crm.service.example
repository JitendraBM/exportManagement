# deploy/crm.service.example
# --------------------------
# systemd unit for the gunicorn process. Copy to
#   /etc/systemd/system/crm.service
# adjust paths / User, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now crm
#
# Logs: journalctl -u crm -f

[Unit]
Description=Ledger CRM (gunicorn)
After=network.target

[Service]
Type=notify
User=crm
Group=crm
WorkingDirectory=/opt/crm/crm_app
EnvironmentFile=/opt/crm/crm_app/.env
ExecStart=/opt/crm/CRMenv/bin/gunicorn -c gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# The app writes uploads + the SQLite DB under crm_app/; keep those writable.
ReadWritePaths=/opt/crm/crm_app/instance /opt/crm/crm_app/app/static/uploads

[Install]
WantedBy=multi-user.target
